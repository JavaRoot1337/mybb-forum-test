{
    "name": "mybb/mybb",
    "description": "MyBB is a free and open source, community-based forum software project.",
    "type": "project",
    "keywords": [
        "forum",
        "community"
    ],
    "homepage": "https://mybb.com",
    "license": "LGPL-3.0-only",
    "authors": [
        {
            "name": "MyBB Group",
            "email": "contact@mybb.com"
        }
    ],
    "support": {
        "forum": "https://community.mybb.com",
        "docs": "https://docs.mybb.com",
        "source": "https://github.com/mybb/mybb",
        "issues": "https://github.com/mybb/mybb/issues"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "chillerlan/php-authenticator": "^5.2",
        "chillerlan/php-qrcode": "^5.0",
        "illuminate/config": "^10.0",
        "illuminate/container": "^10.0",
        "illuminate/events": "^10.0",
        "illuminate/hashing": "^10.0",
        "illuminate/routing": "^10.0",
        "laravel/helpers": "^1.7",
        "scssphp/scssphp": "^2.1",
        "symfony/console": "^7.0",
        "symfony/filesystem": "^7.1",
        "symfony/polyfill-mbstring": "^1.32",
        "twig/twig": "^3.10"
    },
    "require-dev": {
        "mockery/mockery": "^1.5",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "MyBB\\": "../public/inc/src/"
        },
        "files": [
            "../public/inc/src/functions.php",
            "../public/inc/src/View/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MyBB\\Tests\\": "../tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "autoloader-suffix": "MyBB",
        "vendor-dir": "../public/inc/vendor",
        "bin-dir": "../public/inc/vendor/bin",
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "../public/inc/vendor/bin/phpcs --standard=phpcs.xml",
        "phpstan-0": "../public/inc/vendor/bin/phpstan analyse ../public/inc/src -c phpstan.neon --level=0 --no-progress -vvv",
        "phpstan-1": "../public/inc/vendor/bin/phpstan analyse ../public/inc/src -c phpstan.neon --level=1 --no-progress -vvv",
        "phpstan-2": "../public/inc/vendor/bin/phpstan analyse ../public/inc/src -c phpstan.neon --level=2 --no-progress -vvv",
        "phpstan-3": "../public/inc/vendor/bin/phpstan analyse ../public/inc/src -c phpstan.neon --level=3 --no-progress -vvv",
        "phpstan-4": "../public/inc/vendor/bin/phpstan analyse ../public/inc/src -c phpstan.neon --level=4 --no-progress -vvv",
        "phpstan-5": "../public/inc/vendor/bin/phpstan analyse ../public/inc/src -c phpstan.neon --level=5 --no-progress -vvv",
        "phpstan-6": "../public/inc/vendor/bin/phpstan analyse ../public/inc/src -c phpstan.neon --level=6 --no-progress -vvv",
        "phpstan-7": "../public/inc/vendor/bin/phpstan analyse ../public/inc/src -c phpstan.neon --level=7 --no-progress -vvv"
    }
}
